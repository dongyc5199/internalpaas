{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internalpaas.cmict.com/schemas/ui-component-props.json",
  "title": "UI Component Props Schema",
  "description": "JSON Schema definitions for React UI component props (Button, Input, Select, Modal, Table)",
  "version": "1.0.0",
  "definitions": {
    "BaseComponentProps": {
      "type": "object",
      "description": "Base properties shared by all UI components",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "danger", "success", "warning"],
          "default": "primary",
          "description": "Visual variant (style theme)"
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "default": "medium",
          "description": "Component size"
        },
        "disabled": {
          "type": "boolean",
          "default": false,
          "description": "Disable user interaction"
        },
        "loading": {
          "type": "boolean",
          "default": false,
          "description": "Show loading indicator (e.g., spinner)"
        },
        "className": {
          "type": "string",
          "description": "Additional CSS classes for external styling"
        }
      }
    },
    "ButtonProps": {
      "type": "object",
      "description": "Button component properties (extends BaseComponentProps)",
      "allOf": [
        { "$ref": "#/definitions/BaseComponentProps" }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["button", "submit", "reset"],
          "default": "button",
          "description": "HTML button type attribute"
        },
        "fullWidth": {
          "type": "boolean",
          "default": false,
          "description": "Make button full-width"
        },
        "children": {
          "oneOf": [
            { "type": "string" },
            { "type": "object" }
          ],
          "description": "Button content (text or React elements)"
        }
      },
      "required": ["children"],
      "examples": [
        {
          "variant": "primary",
          "size": "medium",
          "type": "submit",
          "loading": false,
          "children": "Submit Form"
        },
        {
          "variant": "danger",
          "size": "small",
          "disabled": false,
          "fullWidth": true,
          "children": "Delete"
        }
      ]
    },
    "InputProps": {
      "type": "object",
      "description": "Input component properties (extends BaseComponentProps)",
      "allOf": [
        {
          "$ref": "#/definitions/BaseComponentProps"
        }
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "Input value (controlled component)"
        },
        "type": {
          "type": "string",
          "enum": ["text", "password", "email", "number", "url"],
          "default": "text",
          "description": "Input type attribute"
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text"
        },
        "label": {
          "type": "string",
          "description": "Field label"
        },
        "error": {
          "type": "string",
          "description": "Error message (shown below input)"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Required field indicator"
        }
      },
      "required": ["value"],
      "examples": [
        {
          "label": "Username",
          "value": "admin",
          "type": "text",
          "placeholder": "Enter username",
          "required": true
        },
        {
          "label": "Email",
          "value": "",
          "type": "email",
          "error": "Invalid email format",
          "required": true
        }
      ]
    },
    "SelectOption": {
      "type": "object",
      "description": "Select dropdown option",
      "properties": {
        "value": {
          "type": "string",
          "description": "Option value (submitted to form)"
        },
        "label": {
          "type": "string",
          "description": "Display label"
        },
        "disabled": {
          "type": "boolean",
          "default": false,
          "description": "Disable this option"
        }
      },
      "required": ["value", "label"]
    },
    "SelectProps": {
      "type": "object",
      "description": "Select component properties (extends BaseComponentProps)",
      "allOf": [
        {
          "$ref": "#/definitions/BaseComponentProps"
        }
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "Currently selected value"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SelectOption"
          },
          "minItems": 1,
          "description": "Available options"
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text (shown when no value selected)"
        },
        "label": {
          "type": "string",
          "description": "Field label"
        },
        "error": {
          "type": "string",
          "description": "Error message"
        }
      },
      "required": ["value", "options"],
      "examples": [
        {
          "label": "Server",
          "value": "1",
          "options": [
            { "value": "1", "label": "Production Server" },
            { "value": "2", "label": "Staging Server" },
            { "value": "3", "label": "Development Server", "disabled": true }
          ],
          "placeholder": "Select a server"
        }
      ]
    },
    "ModalProps": {
      "type": "object",
      "description": "Modal component properties (extends BaseComponentProps)",
      "allOf": [
        {
          "$ref": "#/definitions/BaseComponentProps"
        }
      ],
      "properties": {
        "isOpen": {
          "type": "boolean",
          "description": "Modal visibility state"
        },
        "title": {
          "type": "string",
          "description": "Modal title (shown in header)"
        },
        "children": {
          "oneOf": [
            { "type": "string" },
            { "type": "object" }
          ],
          "description": "Modal content (body)"
        },
        "footer": {
          "oneOf": [
            { "type": "string" },
            { "type": "object" }
          ],
          "description": "Footer content (typically buttons)"
        },
        "closeOnBackdrop": {
          "type": "boolean",
          "default": true,
          "description": "Allow closing by clicking backdrop"
        },
        "showCloseButton": {
          "type": "boolean",
          "default": true,
          "description": "Show close button (X) in header"
        }
      },
      "required": ["isOpen", "title", "children"],
      "examples": [
        {
          "isOpen": true,
          "title": "Confirm Deletion",
          "children": "Are you sure you want to delete this release?",
          "closeOnBackdrop": true,
          "showCloseButton": true
        }
      ]
    },
    "TableColumn": {
      "type": "object",
      "description": "Table column definition",
      "properties": {
        "key": {
          "type": "string",
          "description": "Column unique key (must match data property)"
        },
        "label": {
          "type": "string",
          "description": "Column header label"
        },
        "sortable": {
          "type": "boolean",
          "default": false,
          "description": "Enable sorting for this column"
        },
        "width": {
          "type": "string",
          "pattern": "^(\\d+px|\\d+%|auto)$",
          "description": "Column width (CSS value: '200px', '20%', 'auto')"
        }
      },
      "required": ["key", "label"]
    },
    "TableProps": {
      "type": "object",
      "description": "Table component properties (extends BaseComponentProps)",
      "allOf": [
        {
          "$ref": "#/definitions/BaseComponentProps"
        }
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Data rows (array of objects)"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableColumn"
          },
          "minItems": 1,
          "description": "Column definitions"
        },
        "emptyMessage": {
          "type": "string",
          "default": "No data available",
          "description": "Empty state message"
        }
      },
      "required": ["data", "columns"],
      "examples": [
        {
          "data": [
            { "id": "1", "version": "v1.0.0", "createdAt": "2025-01-31T10:00:00Z" },
            { "id": "2", "version": "v1.1.0", "createdAt": "2025-02-15T14:30:00Z" }
          ],
          "columns": [
            { "key": "version", "label": "Version", "sortable": true, "width": "150px" },
            { "key": "createdAt", "label": "Created At", "sortable": true, "width": "200px" }
          ],
          "loading": false,
          "emptyMessage": "No releases found"
        }
      ]
    }
  },
  "oneOf": [
    {
      "title": "ButtonProps",
      "$ref": "#/definitions/ButtonProps"
    },
    {
      "title": "InputProps",
      "$ref": "#/definitions/InputProps"
    },
    {
      "title": "SelectProps",
      "$ref": "#/definitions/SelectProps"
    },
    {
      "title": "ModalProps",
      "$ref": "#/definitions/ModalProps"
    },
    {
      "title": "TableProps",
      "$ref": "#/definitions/TableProps"
    }
  ],
  "examples": [
    {
      "component": "Button",
      "props": {
        "variant": "primary",
        "size": "large",
        "type": "submit",
        "loading": true,
        "children": "Save Changes"
      }
    },
    {
      "component": "Input",
      "props": {
        "label": "Password",
        "value": "",
        "type": "password",
        "placeholder": "Enter your password",
        "error": "Password is required",
        "required": true
      }
    },
    {
      "component": "Select",
      "props": {
        "label": "Environment",
        "value": "prod",
        "options": [
          { "value": "dev", "label": "Development" },
          { "value": "staging", "label": "Staging" },
          { "value": "prod", "label": "Production" }
        ]
      }
    },
    {
      "component": "Modal",
      "props": {
        "isOpen": false,
        "title": "Edit Release",
        "children": "Release form content goes here",
        "closeOnBackdrop": false
      }
    },
    {
      "component": "Table",
      "props": {
        "data": [],
        "columns": [
          { "key": "name", "label": "Name", "sortable": true },
          { "key": "status", "label": "Status" }
        ],
        "loading": true,
        "emptyMessage": "Loading releases..."
      }
    }
  ]
}
