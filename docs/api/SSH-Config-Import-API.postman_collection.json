{
	"info": {
		"_postman_id": "ssh-config-import-api",
		"name": "SSH Config Import API",
		"description": "SSH配置导入功能API测试集\n\n包含以下接口：\n1. 上传并解析SSH配置文件\n2. 解析本地SSH配置文件\n3. 预览导入（去重检查）\n4. 批量导入服务器\n5. 获取默认配置路径\n\n认证要求：ADMIN或SUPER_ADMIN角色",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "admin",
				"type": "string"
			},
			{
				"key": "password",
				"value": "admin123",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "1. 上传SSH配置文件",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 测试响应状态码",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// 测试响应体包含必要字段",
							"pm.test(\"Response has servers array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('servers');",
							"    pm.expect(jsonData).to.have.property('totalHosts');",
							"});",
							"",
							"// 保存解析结果用于后续测试",
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"parsedServers\", JSON.stringify(jsonData.servers));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": "/path/to/ssh/config"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"upload"
					]
				},
				"description": "上传SSH配置文件并解析\n\n**请求参数:**\n- file: SSH配置文件（最大1MB）\n\n**响应:**\n- 200: 解析成功，返回SSHConfigParseResult\n- 400: 文件为空、超大、格式错误\n- 500: 服务器内部错误"
			},
			"response": []
		},
		{
			"name": "2. 解析本地配置（默认路径）",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 404\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    pm.test(\"Response has servers\", function () {",
							"        var jsonData = pm.response.json();",
							"        pm.expect(jsonData).to.have.property('servers');",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/parse-local",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"parse-local"
					]
				},
				"description": "解析本地SSH配置文件（默认路径 ~/.ssh/config）\n\n**响应:**\n- 200: 解析成功\n- 404: 配置文件不存在\n- 500: 服务器内部错误"
			},
			"response": []
		},
		{
			"name": "3. 解析本地配置（自定义路径）",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/parse-local?path=/custom/path/to/config",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"parse-local"
					],
					"query": [
						{
							"key": "path",
							"value": "/custom/path/to/config"
						}
					]
				},
				"description": "解析自定义路径的SSH配置文件\n\n**参数:**\n- path: 配置文件路径（可选）"
			},
			"response": []
		},
		{
			"name": "4. 预览导入（去重检查）",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Servers have duplicate flag\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        pm.expect(jsonData[0]).to.have.property('duplicate');",
							"        pm.expect(jsonData[0]).to.have.property('valid');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "[\n    {\n        \"name\": \"test-server-1\",\n        \"hostname\": \"192.168.1.100\",\n        \"sshPort\": 22,\n        \"sshUsername\": \"root\",\n        \"sshPassword\": \"password123\",\n        \"port\": 8080,\n        \"serverType\": \"DEVELOPMENT\"\n    },\n    {\n        \"name\": \"test-server-2\",\n        \"hostname\": \"192.168.1.101\",\n        \"sshPort\": 22,\n        \"sshUsername\": \"admin\",\n        \"sshKeyPath\": \"~/.ssh/id_rsa\",\n        \"port\": 8080,\n        \"serverType\": \"TESTING\"\n    }\n]"
				},
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/preview",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"preview"
					]
				},
				"description": "预览导入，执行去重检查\n\n**请求体:**\nServerImportDto数组，包含：\n- name: 服务器名称\n- hostname: 主机名\n- sshPort: SSH端口\n- sshUsername: SSH用户名\n- sshPassword或sshKeyPath: 认证凭证\n\n**响应:**\n返回更新后的服务器列表，包含：\n- duplicate: 是否重复\n- valid: 是否有效\n- missingFields: 缺失字段列表"
			},
			"response": []
		},
		{
			"name": "5. 批量导入服务器",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200, 207 or 400\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 207, 400]);",
							"});",
							"",
							"pm.test(\"Response has result counts\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('successCount');",
							"    pm.expect(jsonData).to.have.property('failedCount');",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    pm.test(\"All servers imported successfully\", function () {",
							"        var jsonData = pm.response.json();",
							"        pm.expect(jsonData.successCount).to.be.above(0);",
							"        pm.expect(jsonData.failedCount).to.equal(0);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "[\n    {\n        \"name\": \"prod-server-1\",\n        \"hostname\": \"192.168.10.100\",\n        \"sshPort\": 22,\n        \"sshUsername\": \"deploy\",\n        \"sshPassword\": \"SecurePass123!\",\n        \"port\": 8080,\n        \"baseWorkDirectory\": \"/opt/apps\",\n        \"description\": \"生产服务器1\",\n        \"serverType\": \"PRODUCTION\"\n    }\n]"
				},
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/batch",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"batch"
					]
				},
				"description": "批量导入服务器\n\n**响应状态码:**\n- 200: 全部成功\n- 207: 部分成功（Multi-Status）\n- 400: 全部失败或参数错误\n- 500: 服务器内部错误\n\n**响应体:**\n- successCount: 成功数量\n- failedCount: 失败数量\n- successServers: 成功服务器列表\n- failures: 失败详情"
			},
			"response": []
		},
		{
			"name": "6. 获取默认配置路径",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has path and exists\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('path');",
							"    pm.expect(jsonData).to.have.property('exists');",
							"    pm.expect(jsonData).to.have.property('message');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/default-path",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"default-path"
					]
				},
				"description": "获取默认SSH配置文件路径和存在性信息\n\n**响应:**\n- path: 默认路径\n- exists: 文件是否存在\n- message: 描述信息"
			},
			"response": []
		},
		{
			"name": "边界测试 - 空文件上传",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Error message contains '空'\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include('空');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": ""
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"upload"
					]
				},
				"description": "边界测试：上传空文件\n\n预期：400 Bad Request"
			},
			"response": []
		},
		{
			"name": "边界测试 - 空服务器列表导入",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Error message mentions empty list\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include('空');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "[]"
				},
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/batch",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"batch"
					]
				},
				"description": "边界测试：批量导入空列表\n\n预期：400 Bad Request"
			},
			"response": []
		},
		{
			"name": "边界测试 - 缺少必填字段",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 or 207\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([400, 207]);",
							"});",
							"",
							"pm.test(\"Response indicates validation failure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.failedCount).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "[\n    {\n        \"name\": \"incomplete-server\",\n        \"hostname\": \"192.168.1.1\"\n    }\n]"
				},
				"url": {
					"raw": "{{baseUrl}}/api/ssh-config-import/batch",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"ssh-config-import",
						"batch"
					]
				},
				"description": "边界测试：缺少必填字段的服务器\n\n缺少：sshUsername, 认证凭证\n\n预期：导入失败，返回验证错误"
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:9090",
			"type": "string"
		}
	]
}
