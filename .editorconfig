# EditorConfig: https://editorconfig.org
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript/JavaScript files
[*.{ts,tsx,js,jsx,json}]
indent_style = space
indent_size = 4

# Markdown, YAML files (2-space indent)
[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

# Java files (backend)
[*.java]
indent_style = space
indent_size = 4
