{
  "name": "internalpaas",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/main/frontend/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/main/frontend/**/*.{ts,tsx}\" --fix",
    "lint:style": "stylelint \"src/main/frontend/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/main/frontend/**/*.{css,scss}\" --fix",
    "format": "prettier --write \"src/main/frontend/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "format:check": "prettier --check \"src/main/frontend/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:codegen": "playwright codegen http://localhost:9090",
    "type-check": "tsc --noEmit",
    "ci:check": "npm run lint && npm run lint:style && npm run type-check && npm run test:run && npm run build",
    "precommit": "npm run format && npm run lint:fix && npm run lint:style:fix && npm run test:run",
    "debt:check": "powershell -ExecutionPolicy Bypass -File scripts/check-debt.ps1",
    "debt:view": "start TECHNICAL_DEBT.md",
    "debt:summary": "start DEBT_SUMMARY.md"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/dongyc519/internalpaas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.19.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "postcss-load-config": "^4.0.2",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.20",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "chart.js": "^4.5.0"
  }
}
