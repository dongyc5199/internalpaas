{
  "name": "internalpaas",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/main/frontend/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/main/frontend/**/*.{ts,tsx}\" --fix",
    "lint:style": "stylelint \"src/main/frontend/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/main/frontend/**/*.{css,scss}\" --fix",
    "format": "prettier --write \"src/main/frontend/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "format:check": "prettier --check \"src/main/frontend/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:codegen": "playwright codegen http://localhost:9090",
    "type-check": "tsc --noEmit",
    "ci:check": "npm run lint && npm run lint:style && npm run type-check && npm run test:run && npm run build",
    "precommit": "npm run format && npm run lint:fix && npm run lint:style:fix && npm run test:run",
    "debt:check": "powershell -ExecutionPolicy Bypass -File scripts/check-debt.ps1",
    "debt:view": "start TECHNICAL_DEBT.md",
    "debt:summary": "start DEBT_SUMMARY.md",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/dongyc519/internalpaas.git"
  },
