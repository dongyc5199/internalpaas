# ========================================
# 数据库配置
# ========================================
DB_PASSWORD=codehub123

# ========================================
# Redis配置
# ========================================
REDIS_PASSWORD=redis123

# ========================================
# Gitea OAuth配置
# ========================================
# 需要在Gitea中创建OAuth应用后填写
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
GITEA_ADMIN_TOKEN=
GITEA_WEBHOOK_SECRET=

# ========================================
# Drone CI配置
# ========================================
# 使用随机字符串，建议使用: openssl rand -hex 16
DRONE_RPC_SECRET=drone_rpc_secret_12345
DRONE_ADMIN_TOKEN=

# ========================================
# SonarQube配置
# ========================================
# 初次启动后在SonarQube中生成token
SONARQUBE_ADMIN_TOKEN=

# ========================================
# Nexus配置
# ========================================
# 初次启动后从 /nexus-data/admin.password 获取初始密码
NEXUS_ADMIN_PASSWORD=

# ========================================
# MinIO配置
# ========================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio123456

# ========================================
# JWT配置
# ========================================
# 使用随机字符串，建议使用: openssl rand -base64 32
JWT_SECRET=jwt_secret_key_change_in_production
